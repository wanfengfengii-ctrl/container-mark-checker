# One-shot acceptance image: runs the Playwright suite (including the
# direct API checks) against the compose stack, then exits.
FROM mcr.microsoft.com/playwright:v1.49.1-jammy

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY playwright.config.ts ./
COPY e2e ./e2e

CMD ["npx", "playwright", "test"]
